# Bedrock draft seam (backend/pipeline/draft.py, ticket #8). Without these — or without
# boto3 installed, or without Bedrock model access enabled in this region (ticket #3) —
# the pipeline falls back to the offline hardcoded sample. No key needed to run demo.py
# or the tests.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS credentials — prefer `aws configure` / an IAM role over putting these here. Only
# fill these in if you're not using a shared credentials file or role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=